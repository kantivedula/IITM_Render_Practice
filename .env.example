# Copy to .env and fill in credentials locally. Never commit .env.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=living-knowledge-emily

# Public website used for proposal context
LIVING_KNOWLEDGE_WEBSITE=https://www.livingknowledge.in

# Optional Microsoft Graph / OneDrive application credentials
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_FOLDER_PATH=

# Optional app settings
HOST=0.0.0.0
PORT=8000
# EMILY_DATABASE_PATH=data/emily.sqlite3
# LOG_LEVEL=INFO

# Optional authenticated ngrok development tunnel
NGROK_ENABLED=false
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=
NGROK_BASIC_AUTH_USER=
NGROK_BASIC_AUTH_PASSWORD=
